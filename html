DEMOS.ml_neural_net = () => {
  const layers = [
    {label:'Input', nodes:3, color:'#3b82f6'},
    {label:'Hidden 1', nodes:4, color:'#10b981'},
    {label:'Hidden 2', nodes:4, color:'#10b981'},
    {label:'Output', nodes:2, color:'#a855f7'},
  ];
  const maxNodes = 4;
  const lw = 54, gap = 52, svgW = layers.length*lw + (layers.length-1)*gap + 20;
  const svgH = 180;
  const nodeR = 12;
  const positions = layers.map((l,li)=>{
    const x = 10 + li*(lw+gap) + lw/2;
    const startY = (svgH - (l.nodes-1)*36) / 2;
    return Array.from({length:l.nodes},(_,ni)=>({x, y:startY+ni*36}));
  });
  let lines = '';
  for(let li=0;li<positions.length-1;li++){
    positions[li].forEach(({x:x1,y:y1})=>{
      positions[li+1].forEach(({x:x2,y:y2})=>{
        lines += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#1e293b" stroke-width="1.5"/>`;
      });
    });
  }
  let circles = '';
  layers.forEach((l,li)=>{
    positions[li].forEach(({x,y})=>{
      circles += `<circle cx="${x}" cy="${y}" r="${nodeR}" fill="${l.color}" opacity="0.85"/>`;
    });
    const lx = positions[li][0].x;
    const ly = svgH - 12;
    circles += `<text x="${lx}" y="${ly}" fill="#64748b" font-size="9" text-anchor="middle">${l.label}</text>`;
  });
  return `<div style="padding:8px">
    <div style="color:#64748b;font-size:11px;margin-bottom:8px">Multilayer Neural Network architecture:</div>
    <svg width="100%" viewBox="0 0 ${svgW} ${svgH}" style="background:#0a1120;border-radius:8px;display:block;margin-bottom:10px">${lines}${circles}</svg>
    <div style="display:flex;gap:6px;flex-wrap:wrap">
      ${layers.map(l=>`<div style="background:#0a1120;border-radius:6px;padding:6px 10px;font-size:10px;border-left:3px solid ${l.color}">
        <span style="color:${l.color};font-weight:600">${l.label}</span>
        <span style="color:#64748b"> ${l.nodes} neurons</span>
      </div>`).join('')}
    </div>
  </div>`;
};

// ═══════════════════════════════════════════════════════════════
// STATE & RENDERING
// ═══════════════════════════════════════════════════════════════
let currentTrack = 'html';
let currentLesson = 0;
let currentTab = 'learn';
const done = {};

function getTrack() { return TRACKS[currentTrack]; }
function getLesson() { return getTrack().lessons[currentLesson]; }
function getColor() { return getTrack().color; }

function switchTrack(track) {
  currentTrack = track;
  currentLesson = 0;
  currentTab = 'learn';
  document.querySelectorAll('.track-tab').forEach(t => {
    t.classList.toggle('active', t.dataset.track === track);
  });
  document.documentElement.style.setProperty('--accent', getColor());
  renderSidebar();
  renderLesson();
}

function switchTab(tab) {
  currentTab = tab;
  document.querySelectorAll('.tab-btn').forEach((t,i) => {
    const tabs = ['learn','demo','practice'];
    t.classList.toggle('active', tabs[i] === tab);
  });
  renderContent();
}

function navigate(dir) {
  const lessons = getTrack().lessons;
  const newIdx = currentLesson + dir;
  if (newIdx >= 0 && newIdx < lessons.length) {
    currentLesson = newIdx;
    currentTab = 'learn';
    document.querySelectorAll('.tab-btn').forEach((t,i) => t.classList.toggle('active', i===0));
    renderLesson();
  }
}

function renderSidebar() {
  const lessons = getTrack().lessons;
  const color = getColor();
  document.getElementById('sidebar').innerHTML = lessons.map((l, i) => `
    <button class="lesson-btn ${i === currentLesson ? 'active' : ''}" onclick="jumpTo(${i})">
      <span class="l-num">${i+1}</span>
      <span class="l-done">${done[l.id] ? '✅' : l.emoji}</span>
      <span class="l-title">${l.title}</span>
    </button>
  `).join('');
}

function jumpTo(i) {
  currentLesson = i;
  currentTab = 'learn';
  document.querySelectorAll('.tab-btn').forEach((t,j) => t.classList.toggle('active', j===0));
  renderLesson();
}

function renderLesson() {
  const lesson = getLesson();
  document.getElementById('lesson-title').innerHTML = `${lesson.emoji} ${lesson.title}`;
  document.getElementById('lesson-concept').innerHTML = `<b>Key Idea:</b> ${lesson.concept}`;
  renderSidebar();
  renderContent();
  renderSidebox();
  renderProgress();
  renderDots();
  const prev = document.getElementById('btn-prev');
  const next = document.getElementById('btn-next');
  prev.disabled = currentLesson === 0;
  next.textContent = currentLesson === getTrack().lessons.length - 1 ? 'Complete ✓' : 'Next →';
}

function renderContent() {
  const lesson = getLesson();
  const el = document.getElementById('content');
  el.className = 'fade';
  void el.offsetWidth;
  el.className = 'fade fade';

  if (currentTab === 'learn') {
    el.innerHTML = lesson.learn;
  } else if (currentTab === 'demo') {
    const demoFn = DEMOS[lesson.demo];
    const html = demoFn ? demoFn() : '<p style="color:#64748b;text-align:center;padding:20px">Demo coming soon</p>';
    el.innerHTML = `<div class="demo-box">
      <div class="demo-header">
        <span class="demo-dot" style="background:#ef4444"></span>
        <span class="demo-dot" style="background:#f59e0b"></span>
        <span class="demo-dot" style="background:#22c55e"></span>
        <span style="margin-left:8px">Interactive Demo — try it!</span>
      </div>
      <div class="demo-body">${html}</div>
    </div>`;
  } else if (currentTab === 'practice') {
    const p = lesson.practice;
    el.innerHTML = `<div style="max-width:500px">
      <div class="section-title">Quick Check</div>
      <div style="background:#0a1120;border:1px solid #1f2937;border-radius:10px;padding:18px;margin-bottom:16px">
        <div style="font-size:14px;font-weight:600;color:#e2e8f0;margin-bottom:6px">${p.q}</div>
        <div style="font-size:12px;color:#475569;margin-bottom:14px">💡 Hint: ${p.hint}</div>
        <input id="prac-input" class="d-input" placeholder="Type your answer..." onkeydown="if(event.key==='Enter')checkAnswer()" />
        <div style="display:flex;gap:8px;margin-top:8px">
          <button class="d-btn" onclick="checkAnswer()">Check Answer</button>
          <button class="d-btn secondary" onclick="document.getElementById('prac-result').innerHTML='<div style=\\'color:#f59e0b\\'>Answer: ${p.a}</div>'">Show Answer</button>
        </div>
        <div id="prac-result" style="margin-top:10px;font-size:13px"></div>
      </div>
      <div class="callout info">
        Practice is how you actually learn. After each lesson, try recreating the demo from scratch in a code editor.
      </div>
    </div>`;
  }
}

function checkAnswer() {
  const input = document.getElementById('prac-input');
  const result = document.getElementById('prac-result');
  const answer = getLesson().practice.a.toLowerCase();
  const given = input.value.trim().toLowerCase();
  if (given === answer || answer.includes(given) && given.length > 2) {
    result.innerHTML = `<div style="color:#22c55e;font-weight:600">✅ Correct! ${done[getLesson().id] ? '' : 'Lesson marked complete.'}</div>`;
    done[getLesson().id] = true;
    renderSidebar();
    renderProgress();
  } else {
    result.innerHTML = `<div style="color:#ef4444">❌ Not quite. Try again or click "Show Answer"</div>`;
  }
}

function renderSidebox() {
  const lesson = getLesson();
  const tips = lesson.tips || [];
  const trackColors = {html:'#f97316', css:'#3b82f6', js:'#eab308', react:'#06b6d4', ml:'#10b981'};
  const trackLabels = {html:'HTML', css:'CSS', js:'JavaScript', react:'React', ml:'ML'};

  document.getElementById('sidebox-body').innerHTML = tips.map(tip => {
    if (tip.track) {
      const c = tip.color || trackColors[tip.track];
      const label = trackLabels[tip.track];
      return `<div class="tip-card">
        <div class="tip-card-head" style="color:${c}">
          <span class="tip-tag" style="background:${c}22;color:${c}">${label}</span>
          ${tip.title}
        </div>
        <div class="tip-card-body">${tip.body}</div>
      </div>`;
    } else {
      return `<div class="tip-card">
        <div class="tip-card-head" style="color:#a855f7">
          <span class="tip-tag" style="background:#a855f722;color:#a855f7">💡 Tip</span>
          ${tip.title}
        </div>
        <div class="tip-card-body">${tip.body}</div>
      </div>`;
    }
  }).join('') + `
    <div style="padding:10px 10px 0">
      <div style="font-size:10px;color:#334155;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px">Course Progress</div>
      ${Object.entries(TRACKS).map(([key, track]) => {
        const c = track.lessons.filter(l => done[l.id]).length;
        const t = track.lessons.length;
        return `<div style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;font-size:10px;margin-bottom:3px">
            <span style="color:${track.color};font-weight:600">${track.label}</span>
            <span style="color:#334155">${c}/${t}</span>
          </div>
          <div style="background:#1e293b;border-radius:99px;height:3px;overflow:hidden">
            <div style="height:100%;width:${t>0?(c/t*100):0}%;background:${track.color};border-radius:99px;transition:width .4s"></div>
          </div>
        </div>`;
      }).join('')}
    </div>`;
}

function renderProgress() {
  const all = Object.values(TRACKS).flatMap(t => t.lessons);
  const completed = all.filter(l => done[l.id]).length;
  document.getElementById('prog-text').textContent = `${completed} / ${all.length}`;
  document.getElementById('prog-fill').style.width = `${(completed/all.length)*100}%`;
}

function renderDots() {
  const lessons = getTrack().lessons;
  document.getElementById('pdots').innerHTML = lessons.map((l, i) =>
    `<div class="pdot ${i === currentLesson ? 'cur' : done[l.id] ? 'done' : ''}" onclick="jumpTo(${i})" title="${l.title}"></div>`
  ).join('');
}

// Initialize
document.documentElement.style.setProperty('--accent', getColor());
renderSidebar();
renderLesson();
</script>
</body>
